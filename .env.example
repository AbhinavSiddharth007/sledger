# Copy to .env.local. Local Supabase values come from `npm run db:start`, which prints them.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The address the app is served from. Magic-link emails send people back to it.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY= ""

ANTHROPIC_API_KEY=""
